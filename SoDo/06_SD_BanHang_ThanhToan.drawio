 thực tại quầy và nd = Quản lý (luồng 6a của UC02)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=4;fillColor=#FFF8D6;strokeColor=#8a7a3a;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="40.0" y="1135.2" width="740.0" height="57.0" as="geometry"/></mxCell><mxCell id="c59" value="ref" style="shape=umlFrame;whiteSpace=wrap;html=1;width=37;height=20;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10.0" y="136.4" width="440.0" height="40.0" as="geometry"/></mxCell><mxCell id="c60" value="SD Ghi nhận khách hàng – Hình 3.3  (chỉ khi hóa đơn có điện thoại)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="37.2" y="150.9" width="385.5" height="19.0" as="geometry"/></mxCell><mxCell id="c61" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=37;height=20;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10.0" y="192.4" width="440.0" height="343.6" as="geometry"/></mxCell><mxCell id="c62" value="[khách được giảm giá]" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;spacing=0;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="53.8" y="193.9" width="130.2" height="19.0" as="geometry"/></mxCell><mxCell id="c63" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=37;height=20;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="272.0" y="758.4" width="443.0" height="272.8" as="geometry"/></mxCell><mxCell id="c64" value="[tongDaThanhToan() ≥ tinhTong()]" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;spacing=0;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="315.8" y="759.9" width="200.1" height="19.0" as="geometry"/></mxCell><mxCell id="c65" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;width=41;height=20;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="